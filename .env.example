# Copia este archivo como .env (no se sube al repositorio).
# Valores para Supabase LOCAL: salen de `npm run db:status` (API_URL, PUBLISHABLE_KEY, SECRET_KEY, MAILPIT_URL).
# Nunca pongas aquí claves de staging ni de producción.

VITE_SUPABASE_URL=http://127.0.0.1:55621
VITE_SUPABASE_PUBLISHABLE_KEY=

# Dominios con los que se puede ingresar. En local se agrega el dominio ficticio de la semilla.
VITE_DOMINIOS_PERMITIDOS=continental.edu.pe,ejemplo.test

# Mostrar el botón «Ingresar con Google» (solo cuando el proveedor esté configurado en Supabase).
VITE_GOOGLE_HABILITADO=false

# Solo para las pruebas e2e en LOCAL: clave secreta de Supabase local (SECRET_KEY) y buzón de Mailpit.
# Nunca la clave secreta de un proyecto en la nube.
E2E_SUPABASE_SECRET_KEY=
E2E_MAILPIT_URL=http://127.0.0.1:55624
