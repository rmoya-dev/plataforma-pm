{
  "name": "plataforma-pm",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de Pensamiento Matemático: motor de certificaciones, sala en vivo y recursos del curso.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @pm/web",
    "build": "npm run build -w @pm/web",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run e2e -w @pm/web",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "supabase": "^3.2.0",
    "typescript": ">=5.9 <6.1",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
